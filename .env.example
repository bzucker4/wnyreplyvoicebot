# Database: the wny-snow-lead-bot Supabase project (session pooler, port 5432).
# Business settings (name, service area, prices, alert phone, booking link) come from
# its `businesses` table; optional voice extras from `voice_settings`.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Local dev without Supabase: DATABASE_URL=sqlite:///local.db and AUTO_CREATE_SCHEMA=true,
# then run scripts/seed_local_business.py
AUTO_CREATE_SCHEMA=false

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=8
ANTHROPIC_MAX_RETRIES=1

# Twilio (one account for every business number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=https://voice.example.com
TTS_VOICE=Polly.Joanna-Neural
SILENCE_TIMEOUT_SECONDS=5
MAX_NO_INPUT_PROMPTS=2
SEND_SMS=true

# Used when a business has no voice_settings.callback_timeframe
DEFAULT_CALLBACK_TIMEFRAME=30 minutes
DISPATCH_API_TOKEN=change-me
